{
  "name": "@coldsofttech/saccade-keyboards",
  "version": "0.1.0",
  "description": "On-screen keyboards for React. Pick a language, or build your own layout from data.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsofttech/SaccadeKeyboards.git",
    "directory": "packages/saccade-keyboards"
  },
  "homepage": "https://github.com/coldsofttech/SaccadeKeyboards#readme",
  "bugs": {
    "url": "https://github.com/coldsofttech/SaccadeKeyboards/issues"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "check:packages": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./style.css && node ../../scripts/check-no-react.js && node ../../scripts/check-pack.js"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
